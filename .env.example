# Copy to .env for local development with `npm run dev:netlify` (Netlify CLI loads it).
# Server-side only: never prefix it with VITE_, or it would be bundled into the browser.
ANTHROPIC_API_KEY=
# Optional: save visitor questions to the Netlify Blobs store "chat-log".
# LOG_QUESTIONS=true
# Optional: for `npm run questions` (reads the chat-log store from your machine).
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
